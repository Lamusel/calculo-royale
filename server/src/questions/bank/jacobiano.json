      "vars": [
        "rho",
        "phi",
        "theta"
      ],
      "abs": true,
      "p": [
        2,
        1.5707963267948966,
        0.7
      ]
    }
  },
  {
    "id": "jc-20",
    "tema": "jacobiano",
    "dificultad": 3,
    "enunciado": "Con $x = 3u$, $y = 2v$ la elipse $\\frac{x^2}{9} + \\frac{y^2}{4} \\le 1$ pasa al disco $u^2 + v^2 \\le 1$. Su área es",
    "opciones": [
      "$6\\pi$",
      "$\\pi$",
      "$5\\pi$"
    ],
    "correcta": 0,
    "explicacion": "$|J| = 3 \\cdot 2 = 6$. Área $= 6 \\cdot$ área del disco unitario $= 6\\pi$.",
    "verifica": {
      "tipo": "cart2",
      "f": "1",
      "cond": "x*x/9+y*y/4<=1",
      "box": [
        -3,
        3,
        -2,
        2
      ]
    }
  },
  {
    "id": "jc-21",
    "tema": "jacobiano",
    "dificultad": 4,
    "enunciado": "$\\frac{\\partial(x,y)}{\\partial(u,v)}$ si $u = xy$, $v = \\frac{y}{x}$ (con $x, y > 0$)",
    "opciones": [
      "$\\frac{1}{2v}$",
      "$2v$",
      "$\\frac{1}{2u}$"
    ],
    "correcta": 0,
    "explicacion": "Es más fácil al revés: $\\frac{\\partial(u,v)}{\\partial(x,y)} = y \\cdot \\frac{1}{x} + x \\cdot \\frac{y}{x^2} = \\frac{2y}{x} = 2v$. El pedido es el recíproco: $\\frac{1}{2v}$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "sqrt(u/v)",
        "sqrt(u*v)"
      ],
      "vars": [
        "u",
        "v"
      ]
    }
  },
  {
    "id": "jc-22",
    "tema": "jacobiano",
    "dificultad": 4,
    "enunciado": "$\\frac{\\partial(x,y,z)}{\\partial(u,v,w)}$ para $x = u + v$, $y = v + w$, $z = u + w$",
    "opciones": [
      "$2$",
      "$0$",
      "$1$"
    ],
    "correcta": 0,
    "explicacion": "Filas $(1,1,0)$, $(0,1,1)$, $(1,0,1)$. Por la primera fila: $1(1 - 0) - 1(0 - 1) + 0 = 2$.",
