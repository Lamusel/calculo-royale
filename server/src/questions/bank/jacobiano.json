[
  {
    "id": "jc-01",
    "tema": "jacobiano",
    "dificultad": 1,
    "enunciado": "Jacobiano de las coordenadas polares $x = r\\cos\\theta$, $y = r\\sin\\theta$",
    "opciones": [
      "$r$",
      "$r^2$",
      "$1$"
    ],
    "correcta": 0,
    "explicacion": "$\\frac{\\partial(x,y)}{\\partial(r,\\theta)} = \\cos\\theta \\cdot r\\cos\\theta + r\\sin\\theta \\cdot \\sin\\theta$. Eso es $r(\\cos^2\\theta + \\sin^2\\theta) = r$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "r*cos(theta)",
        "r*sin(theta)"
      ],
      "vars": [
        "r",
        "theta"
      ]
    }
  },
  {
    "id": "jc-02",
    "tema": "jacobiano",
    "dificultad": 1,
    "enunciado": "En coordenadas cilíndricas, $dV$ es",
    "opciones": [
      "$r\\,dz\\,dr\\,d\\theta$",
      "$dz\\,dr\\,d\\theta$",
      "$r^2\\,dz\\,dr\\,d\\theta$"
    ],
    "correcta": 0,
    "explicacion": "Las cilíndricas son polares más la altura $z$. El jacobiano es el mismo de polares: $r$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "r*cos(theta)",
        "r*sin(theta)",
        "z"
      ],
      "vars": [
        "r",
        "theta",
        "z"
      ],
      "dV": true
    }
  },
  {
    "id": "jc-03",
    "tema": "jacobiano",
    "dificultad": 1,
    "enunciado": "$|J|$ de las coordenadas esféricas $(\\rho, \\phi, \\theta)$",
    "opciones": [
      "$\\rho^2\\sin\\phi$",
      "$\\rho\\sin\\phi$",
      "$\\rho^2\\cos\\phi$"
    ],
    "correcta": 0,
    "explicacion": "Con $x = \\rho\\sin\\phi\\cos\\theta$, $y = \\rho\\sin\\phi\\sin\\theta$, $z = \\rho\\cos\\phi$ el determinante da $\\rho^2\\sin\\phi$. Por eso $dV = \\rho^2\\sin\\phi\\,d\\rho\\,d\\phi\\,d\\theta$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "rho*sin(phi)*cos(theta)",
        "rho*sin(phi)*sin(theta)",
        "rho*cos(phi)"
      ],
      "vars": [
        "rho",
        "phi",
        "theta"
      ],
      "abs": true
    }
  },
  {
    "id": "jc-04",
    "tema": "jacobiano",
    "dificultad": 1,
    "enunciado": "Jacobiano $\\frac{\\partial(x,y)}{\\partial(u,v)}$ de $x = 2u$, $y = 3v$",
    "opciones": [
      "$6$",
      "$5$",
      "$1$"
    ],
    "correcta": 0,
    "explicacion": "La matriz es diagonal: $x_u = 2$, $y_v = 3$. El determinante es $2 \\cdot 3 = 6$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "2*u",
        "3*v"
      ],
      "vars": [
        "u",
        "v"
      ]
    }
  },
  {
    "id": "jc-05",
    "tema": "jacobiano",
    "dificultad": 1,
    "enunciado": "La transformación $x = 2u$, $y = 2v$ multiplica las áreas por",
    "opciones": [
      "$4$",
      "$2$",
      "$8$"
    ],
    "correcta": 0,
    "explicacion": "El factor de área es $|J|$. Aquí $J = 2 \\cdot 2 = 4$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "2*u",
        "2*v"
      ],
      "vars": [
        "u",
        "v"
      ],
      "abs": true
    }
  },
  {
    "id": "jc-06",
    "tema": "jacobiano",
    "dificultad": 1,
    "enunciado": "En $\\iint_R f\\,dA = \\iint_S f\\,(\\,?\\,)\\,du\\,dv$, el factor que falta es",
    "opciones": [
      "el valor absoluto del jacobiano, $|J|$",
      "el jacobiano con su signo, $J$",
      "el inverso, $\\frac{1}{J}$"
    ],
    "correcta": 0,
    "explicacion": "Un área no puede ser negativa. Por eso se usa $|J|$ y no $J$ con su signo.",
    "verifica": {
      "tipo": "concepto",
      "contiene": "valor absoluto"
    }
  },
  {
    "id": "jc-07",
    "tema": "jacobiano",
    "dificultad": 1,
    "enunciado": "Jacobiano $\\frac{\\partial(x,y)}{\\partial(u,v)}$ de $x = u + v$, $y = v$",
    "opciones": [
      "$1$",
      "$2$",
      "$0$"
    ],
    "correcta": 0,
    "explicacion": "$x_u = 1$, $x_v = 1$, $y_u = 0$, $y_v = 1$. $J = 1 \\cdot 1 - 1 \\cdot 0 = 1$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "u+v",
        "v"
      ],
      "vars": [
        "u",
        "v"
      ]
    }
  },
  {
    "id": "jc-08",
    "tema": "jacobiano",
    "dificultad": 2,
    "enunciado": "$\\frac{\\partial(x,y)}{\\partial(u,v)}$ para $x = 2u + v$, $y = u + 3v$",
    "opciones": [
      "$5$",
      "$7$",
      "$-5$"
    ],
    "correcta": 0,
    "explicacion": "$J = x_u y_v - x_v y_u$. $J = 2 \\cdot 3 - 1 \\cdot 1 = 5$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "2*u+v",
        "u+3*v"
      ],
      "vars": [
        "u",
        "v"
      ]
    }
  },
  {
    "id": "jc-09",
    "tema": "jacobiano",
    "dificultad": 2,
    "enunciado": "$\\frac{\\partial(x,y)}{\\partial(u,v)}$ para $x = u + v$, $y = u - v$",
    "opciones": [
      "$-2$",
      "$2$",
      "$0$"
    ],
    "correcta": 0,
    "explicacion": "$J = (1)(-1) - (1)(1) = -2$. El jacobiano lleva signo; en la integral se usa $|J| = 2$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "u+v",
        "u-v"
      ],
      "vars": [
        "u",
        "v"
      ]
    }
  },
  {
    "id": "jc-10",
    "tema": "jacobiano",
    "dificultad": 2,
    "enunciado": "$\\frac{\\partial(x,y)}{\\partial(u,v)}$ para $x = uv$, $y = v$",
    "opciones": [
      "$v$",
      "$u$",
      "$uv$"
    ],
    "correcta": 0,
    "explicacion": "$x_u = v$, $x_v = u$, $y_u = 0$, $y_v = 1$. $J = v \\cdot 1 - u \\cdot 0 = v$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "u*v",
        "v"
      ],
      "vars": [
        "u",
        "v"
      ]
    }
  },
  {
    "id": "jc-11",
    "tema": "jacobiano",
    "dificultad": 2,
