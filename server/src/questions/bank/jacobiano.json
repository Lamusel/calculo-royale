  {
    "id": "jc-23",
    "tema": "jacobiano",
    "dificultad": 4,
    "enunciado": "Área de la región del primer cuadrante entre $xy = 1$, $xy = 4$, $y = x$, $y = 4x$ (use $u = xy$, $v = \\frac{y}{x}$)",
    "opciones": [
      "$3\\ln 2$",
      "$6\\ln 2$",
      "$9$"
    ],
    "correcta": 0,
    "explicacion": "La región es $1 \\le u \\le 4$, $1 \\le v \\le 4$ con $|J| = \\frac{1}{2v}$. $\\int_1^4\\!\\int_1^4 \\frac{1}{2v}\\,dv\\,du = 3 \\cdot \\frac{\\ln 4}{2} = 3\\ln 2$.",
    "verifica": {
      "tipo": "cart2",
      "f": "1",
      "cond": "x*y>=1 && x*y<=4 && y>=x && y<=4*x",
      "box": [
        0,
        2.2,
        0,
        4.2
      ]
    }
  },
