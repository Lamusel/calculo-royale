        "v"
      ],
      "box": [
        0,
        1,
        0,
        1
      ]
    }
  },
  {
    "id": "jc-14",
    "tema": "jacobiano",
    "dificultad": 2,
    "enunciado": "Si $\\frac{\\partial(x,y)}{\\partial(u,v)} = 4$, entonces $\\frac{\\partial(u,v)}{\\partial(x,y)}$ vale",
    "opciones": [
      "$\\frac{1}{4}$",
      "$4$",
      "$-4$"
    ],
    "correcta": 0,
    "explicacion": "Los jacobianos de una transformación y de su inversa son recíprocos. $\\frac{1}{4}$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "4*u",
        "v"
      ],
      "vars": [
        "u",
        "v"
      ],
      "inv": true
    }
  },
  {
    "id": "jc-15",
    "tema": "jacobiano",
    "dificultad": 3,
    "enunciado": "$\\frac{\\partial(x,y)}{\\partial(u,v)}$ para $x = u^2 - v^2$, $y = 2uv$",
    "opciones": [
      "$4(u^2 + v^2)$",
      "$4(u^2 - v^2)$",
      "$2(u^2 + v^2)$"
    ],
    "correcta": 0,
    "explicacion": "$x_u = 2u$, $x_v = -2v$, $y_u = 2v$, $y_v = 2u$. $J = 4u^2 + 4v^2 = 4(u^2 + v^2)$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "u*u-v*v",
        "2*u*v"
      ],
      "vars": [
        "u",
        "v"
      ]
    }
  },
  {
    "id": "jc-16",
    "tema": "jacobiano",
    "dificultad": 3,
    "enunciado": "$\\frac{\\partial(x,y)}{\\partial(u,v)}$ si $u = x + y$, $v = x - y$",
    "opciones": [
      "$-\\frac{1}{2}$",
      "$-2$",
      "$\\frac{1}{2}$"
    ],
    "correcta": 0,
    "explicacion": "Despejando: $x = \\frac{u + v}{2}$, $y = \\frac{u - v}{2}$. $J = \\frac12 \\cdot \\left(-\\frac12\\right) - \\frac12 \\cdot \\frac12 = -\\frac12$. Ojo: $-2$ es $\\frac{\\partial(u,v)}{\\partial(x,y)}$, el inverso.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "(u+v)/2",
        "(u-v)/2"
      ],
      "vars": [
        "u",
        "v"
      ]
    }
  },
  {
    "id": "jc-17",
    "tema": "jacobiano",
    "dificultad": 3,
    "enunciado": "Área de la imagen del rectángulo $0 \\le u \\le 2$, $0 \\le v \\le 1$ bajo $x = 2u + v$, $y = u - v$",
    "opciones": [
      "$6$",
      "$-6$",
      "$2$"
    ],
    "correcta": 0,
    "explicacion": "$J = (2)(-1) - (1)(1) = -3$, así que $|J| = 3$. Área $= 3 \\cdot 2 = 6$ (un área nunca es negativa).",
    "verifica": {
      "tipo": "areaimg",
      "map": [
        "2*u+v",
        "u-v"
      ],
      "vars": [
        "u",
        "v"
      ],
      "box": [
        0,
        2,
        0,
        1
      ]
    }
  },
  {
    "id": "jc-18",
    "tema": "jacobiano",
    "dificultad": 3,
    "enunciado": "$\\frac{\\partial(x,y)}{\\partial(u,v)}$ para $x = e^{u}\\cos v$, $y = e^{u}\\sin v$",
    "opciones": [
      "$e^{2u}$",
      "$e^{u}$",
      "$2e^{u}$"
    ],
    "correcta": 0,
    "explicacion": "$J = e^u\\cos v \\cdot e^u\\cos v + e^u\\sin v \\cdot e^u\\sin v$. $J = e^{2u}(\\cos^2 v + \\sin^2 v) = e^{2u}$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "exp(u)*cos(v)",
        "exp(u)*sin(v)"
      ],
      "vars": [
        "u",
        "v"
      ]
    }
  },
  {
    "id": "jc-19",
    "tema": "jacobiano",
    "dificultad": 3,
    "enunciado": "Valor de $|J|$ de las esféricas en $\\rho = 2$, $\\phi = \\frac{\\pi}{2}$",
    "opciones": [
      "$4$",
      "$2$",
      "$0$"
    ],
    "correcta": 0,
    "explicacion": "$|J| = \\rho^2\\sin\\phi$. $2^2 \\cdot \\sin\\frac{\\pi}{2} = 4$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "rho*sin(phi)*cos(theta)",
        "rho*sin(phi)*sin(theta)",
        "rho*cos(phi)"
