      "$r^2$",
      "$r\\sin\\theta$"
    ],
    "correcta": 0,
    "explicacion": "$z$ no cambia, así que queda el determinante $2 \\times 2$ de polares. $J = r$.",
    "verifica": {
      "tipo": "jac",
      "map": [
        "r*cos(theta)",
        "r*sin(theta)",
        "z"
      ],
      "vars": [
