      ]
    }
  },
  {
    "id": "jc-13",
    "tema": "jacobiano",
    "dificultad": 2,
    "enunciado": "Bajo $x = 3u$, $y = 2v$, el cuadrado $0 \\le u \\le 1$, $0 \\le v \\le 1$ va a una región de área",
    "opciones": [
      "$6$",
      "$5$",
      "$1$"
    ],
    "correcta": 0,
    "explicacion": "Área de la imagen $= |J| \\cdot$ área original. $|J| = 6$ y el cuadrado mide $1$: área $6$.",
    "verifica": {
      "tipo": "areaimg",
      "map": [
        "3*u",
        "2*v"
      ],
      "vars": [
